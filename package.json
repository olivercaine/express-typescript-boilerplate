{
  "name": "express-typescript-boilerplate",
  "version": "3.2.0",
  "description": "A delightful way to building a Node.js RESTful API Services with beautiful code written in TypeScript",
  "main": "src/app.ts",
  "scripts": {
    "start": "nps",
    "dev": "npm install && npm run setup && npm start serve",
    "test": "npm start test",
    "build": "npm start build",
    "presetup": "npm install",
    "lint": "nps lint",
    "lint:fix": "nps lint:fix",
    "setup": "npm start config && npm start setup.script",
    "health-check": "npm i && concurrently --group --kill-others-on-fail 'npm run lint --quiet' 'npm run build' 'npm test' 'npm start test.integration' 'npm start test.e2e'"
  },
  "engines": {
    "node": ">=8.0.0"
  },
  "husky": {
    "hooks": {
      "post-commit": "npm run lint:fix",
      "pre-push": "npm run health-check"
    }
  },
  "repository": "git+ssh://git@github.com/w3tec/express-typescript-boilerplate.git",
  "keywords": [
    "NodeJS",
    "TypeScript",
    "express",
    "boilerplate",
    "skeleton",
    "starter-kit",
    "w3tec.ch"
  ],
  "homepage": "https://github.com/w3tec/express-typescript-boilerplate#readme",
  "author": "w3tec.ch <info@w3tec.ch>",
  "contributors": [
    {
      "name": "David Weber",
      "email": "david.weber@w3tec.ch",
      "url": "https://github.com/dweber019"
    },
    {
      "name": "Gery Hirschfeld",
      "email": "gery.hirschfeld@w3tec.ch",
      "url": "https://github.com/hirsch88"
    }
  ],
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chalk": "^5.3.0",
    "class-validator": "^0.14.1",
    "commander": "^11.1.0",
    "compression": "^1.7.4",
    "copyfiles": "^2.4.1",
    "cors": "^2.8.5",
    "dataloader": "^2.2.2",
    "dotenv": "16.3.1",
    "event-dispatch": "^0.4.1",
    "express": "^4.18.2",
    "express-basic-auth": "^1.2.1",
    "express-graphql": "^0.6.11",
    "express-status-monitor": "^1.3.4",
    "faker": "^6.6.6",
    "figlet": "^1.7.0",
    "glob": "^10.3.10",
    "graphql": "16.8.1",
    "helmet": "^7.1.0",
    "jsonfile": "6.1.0",
    "microframework-w3tec": "^0.6.3",
    "morgan": "^1.10.0",
    "mysql": "^2.18.1",
    "nodemon": "^3.0.3",
    "nps": "^5.10.0",
    "nps-utils": "^1.7.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "routing-controllers": "^0.10.4",
    "serve-favicon": "^2.5.0",
    "supertest": "^6.3.4",
    "swagger-ui-express": "5.0.0",
    "ts-node": "10.9.2",
    "tslint": "5.20",
    "type-graphql": "^1.1.1",
    "typedi": "0.10.0",
    "typeorm": "^0.3.19",
    "typeorm-seeding": "^1.6.1",
    "typeorm-typedi-extensions": "^0.4.1",
    "uuid": "^9.0.1",
    "winston": "3.11.0"
  },
  "resolutions": {
    "**/event-stream": "^4.0.1"
  },
  "jest": {
    "transform": {
      ".(ts|tsx)": "<rootDir>/test/preprocessor.js"
    },
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx|js)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ],
    "testEnvironment": "node",
    "setupTestFrameworkScriptFile": "./test/unit/lib/setup.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bluebird": "^3.5.42",
    "@types/chalk": "^2.2.0",
    "@types/commander": "^2.12.0",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/faker": "^6.6.8",
    "@types/figlet": "^1.5.8",
    "@types/helmet": "0.0.48",
    "@types/jest": "29.5.11",
    "@types/morgan": "^1.9.9",
    "@types/nock": "^10.0.3",
    "@types/reflect-metadata": "0.1.0",
    "@types/serve-favicon": "^2.5.7",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@types/winston": "^2.3.7",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "husky": "^8.0.3",
    "jest": "29.7.0",
    "mock-express-request": "^0.2.2",
    "mock-express-response": "^0.3.0",
    "ncp": "^2.0.0",
    "nock": "13.5.0",
    "sqlite3": "^5.1.7",
    "ts-jest": "29.1.1",
    "typescript": "^5.3.3"
  }
}
